<?xml version="1.0"?>
  <robot name="g1_sim" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- 复用项目中的完整Unitree G1模型及传感器坐标系 -->
    <xacro:include
      filename="$(find g1_description)/urdf/g1.urdf.xacro"/>

    <!-- 当前阶段固定关节和姿态，稍后由仿真节点旋转整个模型 -->
    <gazebo>
      <static>true</static>
    </gazebo>
<!-- ROS标准相机光学坐标系：Z向前、X向右、Y向下 -->
    <link name="camera_color_optical_frame"/>

    <joint name="camera_color_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_color_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
    </joint>
<gazebo reference="camera_link">
      <sensor name="d435_rgbd_sensor" type="depth">
        <always_on>true</always_on>
        <update_rate>15.0</update_rate>
        <visualize>true</visualize>

        <camera>
          <horizontal_fov>1.0472</horizontal_fov>

          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <near>0.15</near>
            <far>10.0</far>
          </clip>
        </camera>

        <plugin name="d435_ros_plugin"
                filename="libgazebo_ros_openni_kinect.so">
          <robotNamespace>/</robotNamespace>
          <cameraName>d435</cameraName>
          <alwaysOn>true</alwaysOn>
          <updateRate>15.0</updateRate>

          <imageTopicName>/camera/color/image_raw</imageTopicName>
          <cameraInfoTopicName>/camera/color/camera_info</cameraInfoTopicName>

          <depthImageTopicName>/camera/aligned_depth_to_color/image_raw</depthImageTopicName>
          <depthImageCameraInfoTopicName>/camera/aligned_depth_to_color/camera_info</depthImageCameraInfoTopicName>

          <pointCloudTopicName>/camera/depth_registered/points</pointCloudTopicName>
          <frameName>camera_color_optical_frame</frameName>

          <pointCloudCutoff>0.15</pointCloudCutoff>
          <pointCloudCutoffMax>10.0</pointCloudCutoffMax>
        </plugin>
      </sensor>
    </gazebo>
<!-- Gazebo virtual 3D lidar -->
    <gazebo reference="mid360_link">
      <sensor name="mid360_ray_sensor" type="ray">
        <always_on>true</always_on>
        <update_rate>5.0</update_rate>
        <visualize>false</visualize>

        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415926</min_angle>
              <max_angle>3.1415926</max_angle>
            </horizontal>

            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.1222</min_angle>
              <max_angle>0.9076</max_angle>
            </vertical>
          </scan>

          <range>
            <min>0.20</min>
            <max>30.0</max>
            <resolution>0.02</resolution>
          </range>

          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>

        <plugin name="mid360_block_laser"
                filename="libgazebo_ros_block_laser.so">
          <robotNamespace>/</robotNamespace>
          <alwaysOn>true</alwaysOn>
          <updateRate>5.0</updateRate>
          <topicName>/simulation/lidar_points</topicName>
          <frameName>mid360_link</frameName>
          <gaussianNoise>0.01</gaussianNoise>
        </plugin>
      </sensor>
    </gazebo>
  </robot>
