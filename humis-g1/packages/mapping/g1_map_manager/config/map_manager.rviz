Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Tool Properties
    Name: Tool Properties
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 48; 48; 48
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 40
      Cell Size: 1
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Show Names: true
    # --- g1_slam_backend ---
    # The optimized global map (loop-corrected point cloud).
    - Class: rviz/PointCloud2
      Name: SlamMap
      Enabled: true
      Topic: /slam/map
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Color Transformer: Intensity
    # The keyframe pose graph (nodes + odometry + loop edges).
    - Class: rviz/MarkerArray
      Name: PoseGraph
      Enabled: false
      Marker Topic: /slam/pose_graph
    # --- g1_slam_frontend ---
    # The live registered scan (odom frame), for live debugging.
    - Class: rviz/PointCloud2
      Name: FrontendCloud
      Enabled: false
      Topic: /slam/frontend/cloud_registered
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Color Transformer: Intensity
    # --- g1_costmap (consumes /slam/keyframes_filtered = SLAM map + edit overlay) ---
    # The 3-state 2D grid map (free=white, occupied=black, unknown=gray).
    - Class: rviz/Map
      Name: CostmapRaw
      Enabled: true
      Topic: /nav/costmap_raw
      Color Scheme: map
      Alpha: 0.7
      Draw Behind: true
    # The rolling local costmap the MPC tracks against (costmap scheme).
    - Class: rviz/Map
      Name: LocalCostmap
      Enabled: false
      Topic: /nav/local_costmap
      Color Scheme: costmap
      Alpha: 0.7
      Draw Behind: false
    # The inflated global costmap (planner input; costmap scheme).
    - Class: rviz/Map
      Name: CostmapInflated
      Enabled: false
      Topic: /nav/costmap
      Color Scheme: costmap
      Alpha: 0.7
      Draw Behind: false
    # The static fusion probability (log-odds), and the dynamic change-layer
    # probability -- diagnostics for tuning.
    - Class: rviz/Map
      Name: CostmapProb
      Enabled: false
      Topic: /nav/costmap_prob
      Color Scheme: map
      Alpha: 0.7
      Draw Behind: true
    - Class: rviz/Map
      Name: ChangeProb
      Enabled: false
      Topic: /nav/change_prob
      Color Scheme: map
      Alpha: 0.7
      Draw Behind: true
    # --- g1_global_planner / g1_local_planner / g1_nav ---
    - Class: rviz/Path
      Name: GlobalPath
      Enabled: true
      Topic: /nav/global_path
      Color: 25; 255; 0
      Line Style: Billboards
      Line Width: 0.05
    - Class: rviz/Path
      Name: LocalPlan
      Enabled: true
      Topic: /nav/local_plan
      Color: 255; 165; 0
      Line Style: Billboards
      Line Width: 0.03
    - Class: rviz/Pose
      Name: NavGoal
      Enabled: true
      Topic: /nav/goal
      Color: 255; 0; 0
      Shaft Length: 0.5
      Shaft Radius: 0.05
    # --- g1_map_manager ---
    # Map-scoped user nav points (SPHERE + TEXT per point).
    - Class: rviz/MarkerArray
      Name: NavPoints
      Enabled: true
      Marker Topic: /map_manager/nav_point_markers
    # Cross-map gateway departure poses (ARROW + TEXT per gateway).
    - Class: rviz/MarkerArray
      Name: Gateways
      Enabled: true
      Marker Topic: /map_manager/gateway_markers
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/FocusCamera
    # 2D Nav Goal -> /move_base_simple/goal (a same-map goal straight to g1_nav).
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    # Publish Point -> /clicked_point (obstacle picking for the map editor).
    - Class: rviz/PublishPoint
      Topic: /clicked_point
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 30
      Name: Current View
