<?xml version="1.0"?>
<package format="2">
  <name>g1_slam_backend</name>
  <version>0.0.1</version>
  <description>SLAM back end for the Unitree G1 in the humis-g1 stack: Scan Context loop detection + GTSAM iSAM2 keyframe pose graph. Consumes the front-end odom + registered cloud, publishes the map-&gt;odom correction and a loop-corrected global map.</description>
  <maintainer email="66817439+rohanhong@users.noreply.github.com">Rohan</maintainer>
  <author email="66817439+rohanhong@users.noreply.github.com">Rohan</author>
  <license>Proprietary</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>eigen_conversions</depend>
  <depend>message_filters</depend>
  <depend>g1_msgs</depend>
  <depend>std_srvs</depend>

  <!-- GTSAM is a system library resolved via find_package(GTSAM) in CMake
       (it is not a rosdep/catkin package), so it carries no depend tag here. -->

  <test_depend>rostest</test_depend>
</package>
