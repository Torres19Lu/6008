Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 40
      Cell Size: 1
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Show Names: true
    - Class: rviz/PointCloud2
      Name: SlamMap
      Enabled: true
      Topic: /slam/map
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Color Transformer: Intensity
    - Class: rviz/MarkerArray
      Name: PoseGraph
      Enabled: true
      Marker Topic: /slam/pose_graph
    - Class: rviz/PointCloud2
      Name: FrontendCloud
      Enabled: false
      Topic: /slam/frontend/cloud_registered
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Color Transformer: Intensity
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/FocusCamera
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 30
      Name: Current View
