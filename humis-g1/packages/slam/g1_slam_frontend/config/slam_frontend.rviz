Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 40
      Cell Size: 1
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Show Names: true
    - Class: rviz/PointCloud2
      Name: CloudRegistered
      Enabled: true
      Topic: /slam/frontend/cloud_registered
      Style: Points
      Size (Pixels): 2
      Decay Time: 300
      Color Transformer: Intensity
    - Class: rviz/Odometry
      Name: Odometry
      Enabled: true
      Topic: /slam/frontend/odom
      Keep: 1
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Shaft Length: 0.3
        Shaft Radius: 0.03
        Head Length: 0.1
        Head Radius: 0.06
    - Class: rviz/Path
      Name: Path
      Enabled: true
      Topic: /slam/frontend/path
      Color: 25; 255; 0
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/FocusCamera
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 20
      Name: Current View
