<?xml version="1.0"?>
<package format="2">
  <name>g1_description</name>
  <version>0.0.1</version>
  <description>URDF, meshes, TF frames, and robot_state_publisher bring-up for the Unitree G1 in the humis-g1 stack.</description>
  <maintainer email="66817439+rohanhong@users.noreply.github.com">Rohan</maintainer>
  <author email="66817439+rohanhong@users.noreply.github.com">Rohan</author>
  <license>Proprietary</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>urdf</depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz</exec_depend>

  <test_depend>rostest</test_depend>
  <test_depend>tf</test_depend>
</package>
