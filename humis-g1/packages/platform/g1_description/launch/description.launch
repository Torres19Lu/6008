<launch>
  <!-- Loads robot_description, runs robot_state_publisher, and publishes the
       dynamic base_footprint. This is the production-shaped description bring-up;
       it does NOT provide a /joint_states source (g1_locomotion publishes the real
       joints from the robot's LowState). For URDF-only visualization without a
       robot, use display.launch (joint_state_publisher sliders/zeros). -->
  <arg name="model" default="$(find g1_description)/urdf/g1.urdf.xacro"/>

  <!-- Camera mount calibration. Simulation keeps the zero defaults and supplies
       its own xacro override. On the real robot set the two environment variables
       before launch, for example:
         export G1_D435_TO_CAMERA_XYZ="0.10 0.00 0.08"
         export G1_D435_TO_CAMERA_RPY="0.00 -0.20 0.00"
       The example numbers are illustrative only; use measured values. -->
  <arg name="d435_to_camera_xyz"
       default="$(optenv G1_D435_TO_CAMERA_XYZ 0 0 0)"/>
  <arg name="d435_to_camera_rpy"
       default="$(optenv G1_D435_TO_CAMERA_RPY 0 0 0)"/>

  <param name="robot_description"
         command="$(find xacro)/xacro $(arg model)
                  d435_to_camera_xyz:='$(arg d435_to_camera_xyz)'
                  d435_to_camera_rpy:='$(arg d435_to_camera_rpy)'"/>

  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher"/>

  <node name="base_footprint_publisher" pkg="g1_description"
        type="base_footprint_publisher" output="screen">
    <rosparam command="load"
              file="$(find g1_description)/config/g1_description.yaml"/>
  </node>
</launch>
