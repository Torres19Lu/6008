Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 48; 48; 48
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 40
      Cell Size: 1
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Show Names: true
    # Primary: the 3-state 2D grid map (free=white, occupied=black,
    # unknown=gray). A flat 2D Map display, no inflation colour.
    - Class: rviz/Map
      Name: CostmapRaw
      Enabled: true
      Topic: /nav/costmap_raw
      Color Scheme: map
      Alpha: 0.7
      Draw Behind: false
    # Toggle: the inflated costmap (move_base "costmap" scheme: lethal magenta,
    # inscribed cyan, cost ramp, free/unknown transparent).
    - Class: rviz/Map
      Name: CostmapGrid
      Enabled: false
      Topic: /nav/costmap
      Color Scheme: costmap
      Alpha: 0.7
      Draw Behind: false
    # Toggle: the static fusion probability (log-odds), "map" scheme.
    - Class: rviz/Map
      Name: CostmapProb
      Enabled: false
      Topic: /nav/costmap_prob
      Color Scheme: map
      Alpha: 0.7
      Draw Behind: true
    - Class: rviz/PointCloud2
      Name: SlamMap
      Enabled: false
      Topic: /slam/map
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Color Transformer: Intensity
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/FocusCamera
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 30
      Name: Current View
