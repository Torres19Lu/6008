<?xml version="1.0"?>
<!--
  g1_local_planner: linear MPC local trajectory tracker for the G1.

  Inputs : /nav/global_path  (nav_msgs/Path, map frame, from g1_global_planner),
           /nav/local_costmap (nav_msgs/OccupancyGrid, rolling window, from g1_costmap),
           /move_base_simple/goal (geometry_msgs/PoseStamped, RViz 2D Nav Goal),
           TF map<-base_link (robot pose).
  Outputs: /cmd_vel          (geometry_msgs/Twist: linear.x=vx, linear.y=vy, angular.z=wz),
           /nav/local_plan   (nav_msgs/Path, predicted MPC trajectory, map frame),
           ~state            (std_msgs/Int8, ControllerState code).

  The node is enable-gated: cmd_vel stays zero until the ~enable service is called.

  This launch offers opt-in args to bring up upstreams (all default off):
    start_costmap  : bring up g1_costmap (publishes /nav/costmap and /nav/local_costmap).
    start_global   : bring up g1_global_planner (publishes /nav/global_path).
    start_slam     : forwarded to g1_costmap (g1_slam_backend).
    start_frontend : forwarded through to g1_slam_frontend.
    start_lidar    : forwarded through to g1_lidar.
    start_state    : forwarded through to g1_locomotion + g1_description.
    map_path       : forwarded to the backend (load + localize at startup).
    interface      : network interface for the robot (default: G1_NETWORK_INTERFACE env).
    rviz           : launch RViz with the local planner view (this launch owns rviz).

  Usage:
    roslaunch g1_local_planner local_planner.launch
    roslaunch g1_local_planner local_planner.launch rviz:=true
    roslaunch g1_local_planner local_planner.launch start_costmap:=true start_global:=true
    roslaunch g1_local_planner local_planner.launch start_costmap:=true start_global:=true start_slam:=true map_path:=/path/to/map rviz:=true
    roslaunch g1_local_planner local_planner.launch start_costmap:=true start_global:=true start_slam:=true start_frontend:=true start_lidar:=true start_state:=true rviz:=true
-->
<launch>
  <arg name="rviz"           default="false"/>
  <arg name="start_costmap"  default="false"/>   <!-- bring up g1_costmap (/nav/local_costmap source) -->
  <arg name="start_global"   default="false"/>   <!-- bring up g1_global_planner (/nav/global_path source) -->
  <arg name="start_slam"     default="false"/>   <!-- forwarded to g1_costmap: g1_slam_backend -->
  <arg name="start_frontend" default="false"/>   <!-- forwarded through: g1_slam_frontend odometry -->
  <arg name="start_lidar"    default="false"/>   <!-- forwarded through: g1_lidar in CustomMsg mode -->
  <arg name="start_state"    default="false"/>   <!-- forwarded through: g1_locomotion + g1_description -->
  <arg name="map_path"       default=""/>        <!-- forwarded to the backend: load + localize at startup -->
  <arg name="interface"      default="$(optenv G1_NETWORK_INTERFACE)"/>

  <!-- Topic wiring this node executes on request. Standalone defaults match the node's
       own defaults; a coordinator (e.g. g1_nav) overrides these so the node routes its
       output/goal onto the coordinator's internal topics. roslaunch honors an <arg>
       passed to an <include> but silently drops a <remap> child of <include>, so the
       coordination flows as args and this launch applies them itself. -->
  <arg name="cmd_topic"      default="/cmd_vel"/>                 <!-- geometry_msgs/Twist output -->
  <arg name="goal_topic"     default="/move_base_simple/goal"/>  <!-- geometry_msgs/PoseStamped goal in -->

  <!-- Optional upstream: the costmap node (and, through it, the SLAM stack).
       This launch owns rviz and does NOT pass rviz down to the costmap. -->
  <include if="$(arg start_costmap)"
           file="$(find g1_costmap)/launch/costmap.launch">
    <arg name="start_slam"     value="$(arg start_slam)"/>
    <arg name="start_frontend" value="$(arg start_frontend)"/>
    <arg name="start_lidar"    value="$(arg start_lidar)"/>
    <arg name="start_state"    value="$(arg start_state)"/>
    <arg name="map_path"       value="$(arg map_path)"/>
    <arg name="interface"      value="$(arg interface)"/>
  </include>

  <!-- Optional upstream: the global planner node (publishes /nav/global_path).
       This launch owns rviz and does NOT pass rviz down to the global planner. -->
  <include if="$(arg start_global)"
           file="$(find g1_global_planner)/launch/global_planner.launch">
    <arg name="start_costmap"  value="false"/>
    <arg name="start_slam"     value="false"/>
    <arg name="start_frontend" value="false"/>
    <arg name="start_lidar"    value="false"/>
    <arg name="start_state"    value="false"/>
    <arg name="map_path"       value="$(arg map_path)"/>
    <arg name="interface"      value="$(arg interface)"/>
  </include>

  <node name="g1_local_planner" pkg="g1_local_planner"
        type="g1_local_planner_node" output="screen">
    <rosparam command="load"
              file="$(find g1_local_planner)/config/local_planner.yaml"/>
    <!-- Override the YAML topic defaults (later param wins) so a coordinator can route
         this node without reaching in with a remap. Defaults leave standalone unchanged. -->
    <param name="cmd_topic"  value="$(arg cmd_topic)"/>
    <param name="goal_topic" value="$(arg goal_topic)"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="local_planner_rviz"
        args="-d $(find g1_local_planner)/config/local_planner.rviz"/>
</launch>
